{
  "name": "hungrys-bucket-cafe",
  "version": "1.0.0",
  "description": "Hungry's Bucket Cafe - Mobile App with Dual Database Support",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "build": "eas build",
    "submit": "eas submit",
    
    "db:mode:test": "echo 'Run this to switch to TEST mode:' && echo '1. Edit config/database.ts' && echo '2. Set DATABASE_MODE = \"TEST\"' && echo '3. Run: npm run build'",
    "db:mode:live": "echo 'Run this to switch to LIVE mode:' && echo '1. Edit config/database.ts' && echo '2. Set DATABASE_MODE = \"LIVE\"' && echo '3. Run: npm run build'",
    
    "clone:collections": "ts-node scripts/cloneCollections.ts --mode all --from live --to test",
    "clone:collections:selective": "ts-node scripts/cloneCollections.ts --collections customers,orders,menuItems,coupons,categoris",
    "clone:collections:overwrite": "ts-node scripts/cloneCollections.ts --mode all --from live --to test --overwrite",
    "clone:collections:test-to-live": "ts-node scripts/cloneCollections.ts --mode all --from test --to live",
    "clone:collections:help": "ts-node -e \"console.log('Usage: npm run clone:collections -- [options]\\n\\nOptions:\\n  --mode all|selected        Clone all or specific collections\\n  --collections a,b,c       Comma-separated list of collections\\n  --from live|test          Source mode\\n  --to live|test            Destination mode\\n  --skip-existing           Skip documents that already exist\\n  --overwrite               Overwrite existing documents\\n\\nExamples:\\n  npm run clone:collections                           # Clone all LIVE→TEST\\n  npm run clone:collections:selective                 # Clone specific collections\\n  npm run clone:collections:overwrite                 # Overwrite TEST collections\\n  npm run clone:collections:test-to-live              # Mirror TEST→LIVE\\n')\"",
    
    "verify:collections": "ts-node -e \"import { getAllCollectionNames } from './config/database'; console.table(getAllCollectionNames());\"",
    "verify:mode": "ts-node -e \"import { IS_TEST_DATABASE, DATABASE_MODE } from './config/database'; console.log('Current Mode:', DATABASE_MODE); console.log('Is Test Database:', IS_TEST_DATABASE);\"",
    
    "docs:quick": "cat docs/QUICK_REFERENCE.md",
    "docs:setup": "cat docs/DUAL_DATABASE_SETUP.md",
    "docs:migration": "cat docs/DATABASE_MIGRATION_GUIDE.md",
    "docs:summary": "cat IMPLEMENTATION_SUMMARY.md"
  },
  "comments": {
    "database": {
      "description": "Dual Database System - Change DATABASE_MODE in config/database.ts and rebuild",
      "modes": "LIVE: production collections | TEST: test_* collections",
      "toggle": "Edit config/database.ts → DATABASE_MODE = 'LIVE' | 'TEST' → npm run build"
    },
    "clone_collections": {
      "description": "Copy collections between LIVE and TEST databases",
      "usage": {
        "all": "npm run clone:collections              # Clone all LIVE→TEST",
        "selective": "npm run clone:collections:selective     # Clone specific",
        "overwrite": "npm run clone:collections:overwrite     # Overwrite TEST",
        "test-to-live": "npm run clone:collections:test-to-live  # Mirror TEST→LIVE",
        "help": "npm run clone:collections:help         # Show help"
      }
    },
    "verify": {
      "description": "Verify database configuration",
      "collections": "npm run verify:collections  # List all configured collections",
      "mode": "npm run verify:mode          # Show current mode (LIVE/TEST)"
    },
    "docs": {
      "description": "View documentation",
      "quick": "npm run docs:quick           # 1-page quick reference",
      "setup": "npm run docs:setup           # Complete setup guide",
      "migration": "npm run docs:migration       # Refactoring patterns",
      "summary": "npm run docs:summary         # Implementation summary"
    }
  }
}
