# Backend URL comes from the app mode (EXPO_PUBLIC_DATABASE_MODE) — see config/api.ts:
#   LIVE → https://backend.prayagifoodwala.com/api, TEST → this computer's backend on port 4000.
# Optional: force the TEST address (e.g. your LAN IP for a TEST-mode APK):
# EXPO_PUBLIC_TEST_API_URL=http://192.168.1.14:4000/api
EXPO_PUBLIC_ORG_SLUG=hungry-s-bucket-cafe
